{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Read(/.git/**)",
      "Read(/.local/private/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.key)",
      "Read(//**/*.pem)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.keystore)"
    ]
  }
}
