{
  "name": "semnome",
  "version": "0.1.0-alpha.3",
  "private": true,
  "license": "UNLICENSED",
  "description": "A local desktop workbench — foundation prototype, Windows first.",
  "type": "module",
  "main": "out/main/index.cjs",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tools tests examples sdk electron.vite.config.ts",
    "test": "node --experimental-strip-types tools/test.ts",
    "check:repo": "node --experimental-strip-types tools/check-repo.ts",
    "doctor": "node --experimental-strip-types tools/doctor.ts",
    "check": "pnpm check:repo && pnpm typecheck && pnpm lint && pnpm test && pnpm plugins:build && pnpm build",
    "plugins:build": "node --experimental-strip-types tools/build-plugins.ts",
    "test:desktop": "node --experimental-strip-types tools/desktop-smoke.ts",
    "test:desktop:dev": "node --experimental-strip-types tools/desktop-smoke.ts --dev",
    "github:prepare": "node --experimental-strip-types tools/github-prepare.ts"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.6.0",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "playwright": "1.56.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6"
  }
}
